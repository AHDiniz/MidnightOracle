@domain
Package Domain {
    @persistent
    Class User {
        @id
        _id: Long {generation=auto},

        email: String {notnull},
        username: String {notnull},
        password: String {notnull},
    }

    @persistent
    Class RSSFeed {
        @id
        _id: Long {generation=auto},

        // Obrigatórios de RSS
        url: String {notnull},
        title: String {notnull},
        description: String {notnull},

        // Opcionais
        pub_date: Timestamp {precision=datetime},
        last_build_date: Timestamp {precision=datetime},
        image_url: String,
    }

    @persistent
    Class RSSItem {
        @id
        _id: Long {generation=auto},

        title: String,
        link: String,
        description: String,

        enclosure_url: String,
    }

    @persistent
    Class Category {
        @id
        _id: Long {generation=auto},
        name: String {notnull},
    }

    Association {
        User [1] -- [*] RSSFeed
        RSSFeed [*] -- [*] Category
        RSSFeed [1] -- [*] RSSItem
        RSSItem [*] -- [*] Category
    }
}

@controller
Package Control {
    Class RegController {
        user: User,

        register(): String,
    }

    Class LoginController {
        user: User,

        login(): User,
    }

    Dependency {
        RegController -> RegSuccess
        RegController -> RegFailure
        LoginController -> Homepage
    }

    Association {
        RegController -> AuthenticationService
        LoginController -> AuthenticationService
    }
}

@view
Package Navigation {
    // Página inicial e login
    @page
    Class Index {}

    @form
    Class RegForm {
        user__email: inputText,
        user__username: inputText,
        user__password: inputSecret,

        register: commandButton,
    }

    @form
    Class LoginForm {
        user__username: inputText,
        user__password: inputSecret,

        login: commandButton,
    }

    @page
    Class RegSuccess {
        user__username: outputText,
    }

    @page
    Class RegFailure {
        user__email: outputText,
        user__username: outputText,
    }

    Composition {
        Index -> RegForm
        Index -> LoginForm
    }

    Dependency {
        RegForm -> RegController
        LoginForm -> LoginController
    }

    // Já logado
    @page
    Class Homepage {
        user__username: String,
    }

    @form
    Class RSSFeedForm {
        rssfeed__url: String,

        register: commandButton,
    }

    @form
    Class RSSItemForm {
        rssitem__title: String,

        add_category: commandButton,
    }

    Composition {
        Homepage -> RSSFeedForm
        Homepage -> RSSItemForm
    }

    Dependency {
        RSSFeedForm -> FeedService
        RSSItemForm -> FeedService
    }
}

@service
Package Application {
    Class AuthenticationService {
        register(): String,
        login(): User,
    }

    Class FeedService {
        register_feed(): RSSFeed,
        read_feed(feed): List,
        add_category_to_feed(feed, category): Category,
        add_category_to_item(item, category): Category,
    }

    Dependency {
        AuthenticationService -> UserDAO
        FeedService -> RSSFeedDAO
        FeedService -> RSSItemDAO
        FeedService -> CategoryDAO
    }
}

@persistence
Package Persistence {
    Class UserDAO {
        get(username, password): User,
        create(email, username, password): User,
    }

    Class RSSFeedDAO {
        create(
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        update(
            _id,
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        list_by_user(user): List,
        add_categories(categories): RSSFeed,
        delete(_id): nil,
    }

    Class RSSItemDAO {
        create(title, link, description, enclosure_url): RSSItem,
        update(_id, title, link, description, enclosure_url): RSSItem,
        list_by_feed(rss_feed): List,
        add_categories(categories): RSSItem,
        delete(_id): nil,
    }

    Class CategoryDAO {
        create(name): Category,
        list_by_user(user): List,
        list_by_feed(rss_feed): List,
        list_by_item(rss_item): List,
        delete(_id): nil,
    }
}
