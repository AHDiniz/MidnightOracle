@domain
Package Domain {
    @persistent
    Class User {
        @id
        _id: Long {generation=auto},

        email: String {notnull},
        username: String {notnull},
        password: String {notnull},
    }

    @persistent
    Class RSSFeed {
        @id
        _id: Long {generation=auto},

        // Obrigatórios de RSS
        url: String {notnull},
        title: String {notnull},
        description: String {notnull},

        // Opcionais
        pub_date: Timestamp {precision=datetime},
        last_build_date: Timestamp {precision=datetime},
        image_url: String,
    }

    @persistent
    Class RSSItem {
        @id
        _id: Long {generation=auto},

        title: String,
        link: String,
        description: String,

        enclosure_url: String,
    }

    @persistent
    Class Category {
        @id
        _id: Long {generation=auto},
        name: String {notnull},
    }

    Association {
        User [1] -- [*] RSSFeed
        RSSFeed [*] -- [*] Category
        RSSFeed [1] -- [*] RSSItem
        RSSItem [*] -- [*] Category
    }
}

