@domain
Package Datatypes {
    @persistent
    Class User {
        @id
        _id: Long {generation=auto},

        email: String {notnull},
        username: String {notnull},
        password: String {notnull},
    }

    @persistent
    Class RSSFeed {
        @id
        _id: Long {generation=auto},

        // Obrigatórios de RSS
        url: String {notnull},
        title: String {notnull},
        description: String {notnull},

        // Opcionais
        pub_date: Timestamp {precision=datetime},
        last_build_date: Timestamp {precision=datetime},
        image_url: String,
    }

    @persistent
    Class RSSItem {
        @id
        _id: Long {generation=auto},

        title: String,
        link: String,
        description: String,

        enclosure_url: String,
    }

    @persistent
    Class Category {
        @id
        _id: Long {generation=auto},
        name: String {notnull},
    }

    Association {
        User [1] -- [*] RSSFeed
        RSSFeed [*] -- [*] Category
        RSSFeed [1] -- [*] RSSItem
        RSSItem [*] -- [*] Category
    }
}

@view
Package AuthView {
    // Página inicial e login
    @page
    Class IndexPage {}

    @page
    Class RegistrationPage {}

    @form
    Class RegForm {
        user__email: inputText,
        user__username: inputText,
        user__password: inputSecret,

        register: commandButton,
    }

    @form
    Class LoginForm {
        user__username: inputText,
        user__password: inputSecret,

        login: commandButton,
    }

    @page
    Class RegSuccess {
        user__username: outputText,
    }

    @page
    Class RegFailure {
        user__email: outputText,
        user__username: outputText,
    }

    Composition {
        RegistrationPage -> RegForm
        IndexPage -> LoginForm
    }

    Dependency {
        // Links entre páginas
        IndexPage -> RegistrationPage

        // Usos de Controllers
        RegForm -> RegController
        LoginForm -> LoginController
    }
}

@view
Package UserView {
    // Já logado
    @page
    Class Homepage {
        user__username: String,
        list: List,
    }

    @page
    Class RSSFeedPage {
        rss_feed: RSSFeed,
        list: List,
    }

    @page
    Class RSSItemPage {
        item: RSSItem,
    }

    @form
    Class RegisterFeedForm {
        rssfeed__url: String,

        register: commandButton,
    }

    @form
    Class CategorizeFeedForm {
        rssfeed__id: Int,
        category: String,

        add_category: commandButton,
    }

    @form
    Class RSSItemForm {
        rssitem__title: String,

        add_category: commandButton,
    }

    Composition {
        Homepage -> RegisterFeedForm
        RSSFeedPage -> CategorizeFeedForm
        RSSItemPage -> RSSItemForm
    }

    Dependency {
        CategorizeFeedForm -> FeedController
        RegisterFeedForm -> FeedController
        RSSItemForm -> FeedController

        Homepage -> RSSFeedPage
        RSSFeedPage -> RSSItemPage
    }
}

@controller
Package Control {
    Class RegController {
        user: User,

        register(): Bool,
    }

    Class LoginController {
        user: User,

        login(): User,
    }

    Class FeedController {
        feed: RSSFeed,

        list(): List,
        create(): RSSFeed,
        add_category(): Nil,
    }

    Dependency {
        RegController -> RegSuccess
        RegController -> RegFailure
        LoginController -> Homepage
    }

    Association {
        RegController -> AuthenticationService
        LoginController -> AuthenticationService
        FeedController -> FeedService
        FeedController -> ItemService
    }
}

@service
Package Application {
    Class AuthenticationService {
        register(): Bool,
        login(): User,
    }

    Class FeedService {
        register_feed(): RSSFeed,
        read_feed(feed): List,
        add_category_to_feed(feed, category): Nil,
    }

    Class ItemService {
        save_item(item): RSSItem,
        add_category_to_item(item, category): Nil,
    }

    Dependency {
        AuthenticationService -> UserDAO

        FeedService -> RSSFeedDAO
        FeedService -> RSSItemDAO
        FeedService -> CategoryDAO

        ItemService -> RSSItemDAO
        ItemService -> CategoryDAO
    }
}

@persistence
Package Persistence {
    Class UserDAO {
        get(username, password): User,
        create(email, username, password): User,
    }

    Class RSSFeedDAO {
        create(
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        update(
            _id,
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        list_by_user(user): List,
        add_categories(categories): RSSFeed,
        delete(_id): Nil,
    }

    Class RSSItemDAO {
        create(title, link, description, enclosure_url): RSSItem,
        update(_id, title, link, description, enclosure_url): RSSItem,
        list_by_feed(rss_feed): List,
        add_categories(categories): RSSItem,
        delete(_id): Nil,
    }

    Class CategoryDAO {
        create(name): Category,
        list_by_user(user): List,
        list_by_feed(rss_feed): List,
        list_by_item(rss_item): List,
        delete(_id): Nil,
    }
}
