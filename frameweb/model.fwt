@persistence
Package Persistence {
    Class UserDAO {
        get(username, password): User,
        create(email, username, password): User,
    }

    Class RSSFeedDAO{
        create(
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        update(
            _id,
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        list_by_user(user): List
        delete(_id): nil
    }

    Class RSSItemDAO {
        create(title, link, description, enclosure_url): RSSItem
        update(_id, title, link, description, enclosure_url): RSSItem
        list_by_feed(rss_feed): List
        delete(_id): nil
    }

    Class CategoryDAO {
        create(name): Category,
        list_by_user(user): List
        list_by_feed(rss_feed): List
        list_by_item(rss_item): List
        delete(_id): nil
    }
}
