@domain
Package Domain {
    @persistent
    Class User {
        @id
        _id: Long {generation=auto},

        email: String {notnull},
        username: String {notnull},
        password: String {notnull},
    }

    @persistent
    Class RSSFeed {
        @id
        _id: Long {generation=auto},

        // Obrigatórios de RSS
        url: String {notnull},
        title: String {notnull},
        description: String {notnull},

        // Opcionais
        pub_date: Timestamp {precision=datetime},
        last_build_date: Timestamp {precision=datetime},
        image_url: String,
    }

    @persistent
    Class RSSItem {
        @id
        _id: Long {generation=auto},

        title: String,
        link: String,
        description: String,

        enclosure_url: String,
    }

    @persistent
    Class Category {
        @id
        _id: Long {generation=auto},
        name: String {notnull},
    }

    Association {
        User [1] -- [*] RSSFeed
        RSSFeed [*] -- [*] Category
        RSSFeed [1] -- [*] RSSItem
        RSSItem [*] -- [*] Category
    }
}

@controller
Package Control {
    Class AuthenticationController {
        user: User,

        register(): String,
        login(): String,
    }

    Dependency {
        AuthenticationController -> RegSuccess
        AuthenticationController -> RegFailure
    }

    Association {
        AuthenticationController -> AuthenticationService
    }
}

@view
Package Navigation {
    @page
    Class Index {}

    @form
    Class RegForm {
        user__email: inputText,
        user__username: inputText,
        user__password: inputSecret,

        register: commandButton,
    }

    @page
    Class RegSuccess {
        user__username: outputText,
    }

    @page
    Class RegFailure {}

    Composition {
        Index -> RegForm
    }

    Dependency {
        RegForm -> AuthenticationController
    }
}

@service
Package Application {
    Class AuthenticationService {
        register(): String,
        login(): User,
    }

    Class FeedService {
        register_feed(): RSSFeed,
        add_category_to_feed(): Category,
    }

    Dependency {
        AuthenticationService -> UserDAO
        FeedService -> RSSFeedDAO
        FeedService -> CategoryDAO
    }
}

@persistence
Package Persistence {
    Class UserDAO {
        get(username, password): User,
        create(email, username, password): User,
    }

    Class RSSFeedDAO {
        create(
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        update(
            _id,
            url,
            title,
            description,
            pub_date,
            last_build_date,
            image_url
        ): RSSFeed,
        list_by_user(user): List,
        delete(_id): nil,
    }

    Class RSSItemDAO {
        create(title, link, description, enclosure_url): RSSItem,
        update(_id, title, link, description, enclosure_url): RSSItem,
        list_by_feed(rss_feed): List,
        delete(_id): nil,
    }

    Class CategoryDAO {
        create(name): Category,
        list_by_user(user): List,
        list_by_feed(rss_feed): List,
        list_by_item(rss_item): List,
        delete(_id): nil,
    }
}
